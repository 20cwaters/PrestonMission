# Cache rules (the same as netlify.toml's, which Cloudflare Pages ignores).
# Photos never change once written; letters and pages must always be re-checked.
/photos/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
